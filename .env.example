# ─────────────────────────────────────────────────────────────────────────────
# Market Detective — backend environment
# Copy to  backend/.env  and fill in your own values.  NEVER commit backend/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Persistence backend ──────────────────────────────────────────────────────
# "mongo"  → use MongoDB Atlas / a MongoDB server via MONGODB_URI  (recommended)
# "memory" → use the file-backed local store (no MongoDB needed; fully offline)
# "auto"   → use mongo if MONGODB_URI is set and reachable, else fall back to memory
DB_BACKEND=auto

# ── MongoDB Atlas (application persistence ONLY — never a market-data source) ──
# Get this from Atlas → Cluster → Connect → Drivers.  Keep the credentials secret.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_URL/?retryWrites=true&w=majority
MONGODB_DB_NAME=market_detective

# Separate database used by the integration test-suite. MUST be different from the
# production DB name. Tests refuse to run against a DB whose name does not end in
# "_test" unless MARKET_DETECTIVE_ALLOW_UNSAFE_TEST_DB=1 is also set.
MONGODB_TEST_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_URL/?retryWrites=true&w=majority
MONGODB_TEST_DB_NAME=market_detective_test

# ── API ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000

# ── Demo dataset / clock ─────────────────────────────────────────────────────
# Number of hourly market bars a single "Advance Market Time" click moves forward.
DEMO_CLOCK_ADVANCE_BARS=18
# Path where the file-backed local store keeps its JSON (used by the memory backend).
LOCAL_STORE_DIR=.local_store
