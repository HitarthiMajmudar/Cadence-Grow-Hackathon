# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local application store (file-backed fallback for MongoDB)
backend/.local_store/

# NOTE: data/generated/ IS committed on purpose — it is the offline research
# dataset the app ships with so the demo runs with no internet access.

# Node
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Env / secrets — never commit real credentials
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
